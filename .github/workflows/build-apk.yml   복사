
name: Android TV APK 만들기

on:
  workflow_dispatch:
    inputs:
      player_url:
        description: '시니어교육TV Player 주소'
        required: true
        type: string
        default: 'https://senior-tv-player.pages.dev'

permissions:
  contents: read

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: 소스 가져오기
        uses: actions/checkout@v4

      - name: Java 17 설치
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Android SDK 준비
        uses: android-actions/setup-android@v3

      - name: Android API 설치
        run: sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Gradle 준비
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: APK 생성
        env:
          PLAYER_URL: ${{ inputs.player_url }}
        run: |
          gradle :app:assembleDebug \
            -PseniorPlayerUrl="$PLAYER_URL" \
            --no-daemon

      - name: APK 파일 등록
        uses: actions/upload-artifact@v4
        with:
          name: senior-education-tv-android-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
